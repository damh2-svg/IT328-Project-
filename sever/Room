package server;

import java.util.*;

public class Room {
    private ArrayList<ClientHandler> players; 
    private final int MAX_PLAYERS = 4;
    private boolean isGameStarted = false; 
    private boolean isWaitingQueue;
    private ServerGUI serverGUI;
    private Timer gameTimer;
    private int secondsLeft;

    private HashMap<String, Integer> scores; 
    private int currentRound = 0;
    private final int TOTAL_ROUNDS = 5;
    private char currentLetter;

    public Room(boolean isWaitingQueue, ServerGUI serverGUI) {
        this.players = new ArrayList<>();
        this.scores = new HashMap<>();
        this.isWaitingQueue = isWaitingQueue;
        this.serverGUI = serverGUI;
    }

    public synchronized boolean addPlayer(ClientHandler player) {
        if (players.contains(player)) return false;

        if (isWaitingQueue) {
            players.add(player);
            broadcastRoomUpdate();
            return true;
        }

        // --- التعديل هنا: إرسال الإشعار للبقية فقط وليس للاعب نفسه ---
        for (ClientHandler p : players) {
            p.sendMessage("NOTIFICATION:👤 Player " + player.getClientName() + " has joined the Play Room!");
        }

        players.add(player);
        player.sendMessage("ROOM_TYPE:PLAY_ROOM");
        // نرسل للاعب المنضم رسالة ترحيب خاصة به فقط إذا أردتِ
        player.sendMessage("NOTIFICATION:Welcome to the Play Room!");
        
        broadcastRoomUpdate();

        if (isFullOrStarted()) {
            serverGUI.broadcastToLobby("PLAY_ROOM_FULL");
        }

                // --- التعديل هنا: إضافة تأخير ثانية عند اكتمال العدد لـ 4 لاعبين ---
        if (players.size() == 2 && !isGameStarted) {
            startTimer(); // يبدأ عد الـ 30 ثانية المعتاد
        } else if (players.size() == MAX_PLAYERS && !isGameStarted) {
            // ننتظر ثانية واحدة لكي يظهر اسم اللاعب الرابع في القائمة قبل أن تبدأ اللعبة فجأة
            new Timer().schedule(new TimerTask() {
                @Override
                public void run() {
                    startGame();
                }
            }, 1000); 
        }


        return true;
    }

    public synchronized void removePlayer(ClientHandler player) {
        players.remove(player);
        
        if (isGameStarted) {
            broadcastToRoom("NOTIFICATION:⚠️ Player " + player.getClientName() + " has left the game.");
            if (players.size() == 1) {
                broadcastToRoom("NOTIFICATION:📢 All other players left. Ending game...");
                endGame(); 
            }
        } 

        if (!isWaitingQueue) { 
            if (players.size() < 2 && gameTimer != null && !isGameStarted) {
                gameTimer.cancel();
                gameTimer = null;
                broadcastToRoom("TIMER_STOP");
            }
            
            if (!isFullOrStarted() && !isGameStarted) {
                serverGUI.broadcastToLobby("PLAY_ROOM_AVAILABLE");
            }
        }
        broadcastRoomUpdate();
    }

    private void startTimer() {
        if (gameTimer != null) gameTimer.cancel();
        secondsLeft = 30;
        gameTimer = new Timer();
        gameTimer.scheduleAtFixedRate(new TimerTask() {
            @Override
            public void run() {
                if (secondsLeft > 0) {
                    broadcastToRoom("TIMER_UPDATE:" + secondsLeft);
                    secondsLeft--;
                } else {
                    startGame();
                }
            }
        }, 0, 1000);
    }

    private synchronized void startGame() {
        if (isGameStarted) return;
        isGameStarted = true;
        
        if (gameTimer != null) gameTimer.cancel();

        for (ClientHandler p : players) {
            scores.put(p.getClientName(), 0);
        }

        broadcastToRoom("TIMER_STOP");
        // إرسال رسالة البداية
        broadcastToRoom("NOTIFICATION:🔥 GAME STARTED! 🔥");
        serverGUI.broadcastToLobby("PLAY_ROOM_FULL");
        
        // --- تعديل الرسايل: ننتظر 3 ثواني لتختفي رسالة البداية ثم يبدأ الحرف الأول ---
        new Timer().schedule(new TimerTask() {
            @Override
            public void run() {
                startNextRound();
            }
        }, 3000); 
    }

    private void startNextRound() {
        if (currentRound >= TOTAL_ROUNDS) {
            endGame();
            return;
        }

        currentRound++;
        currentLetter = (char) ('A' + new Random().nextInt(26));
        
        // نرسل إشعار الحرف
        broadcastToRoom("NOTIFICATION:Round " + currentRound + "! Starting Letter: " + currentLetter);
        
        // ننتظر ثانية واحدة بعد إشعار الحرف قبل تحديث الواجهة برسالة NEW_ROUND
        // لضمان أن اللاعب رأى الحرف في الـ Notification أولاً
        new Timer().schedule(new TimerTask() {
            @Override
            public void run() {
                broadcastToRoom("NEW_ROUND:" + currentRound + ":" + currentLetter);
                runRoundTimer(15); 
            }
        }, 2000);
    }

    private void runRoundTimer(int seconds) {
        if (gameTimer != null) gameTimer.cancel();
        secondsLeft = seconds;
        gameTimer = new Timer();
        gameTimer.scheduleAtFixedRate(new TimerTask() {
            @Override
            public void run() {
                if (secondsLeft > 0) {
                    broadcastToRoom("TIMER_UPDATE:" + secondsLeft);
                    secondsLeft--;
                } else {
                    // قبل الانتقال للجولة التالية، نرسل إشعاراً بانتهاء الوقت
                    broadcastToRoom("NOTIFICATION:Time's up for Round " + currentRound + "!");
                    new Timer().schedule(new TimerTask() {
                        @Override
                        public void run() {
                            startNextRound();
                        }
                    }, 1500); // انتظار بسيط قبل الجولة القادمة
                }
            }
        }, 0, 1000);
    }

    public synchronized void handleSubmittedWord(String playerName, String word) {
        if (!isGameStarted) return;

        if (word.toUpperCase().startsWith(String.valueOf(currentLetter))) {
            int earnedPoints = word.length();
            int currentTotal = scores.getOrDefault(playerName, 0);
            scores.put(playerName, currentTotal + earnedPoints);
            syncScores();
        }
    }

    private void syncScores() {
        StringBuilder sb = new StringBuilder("UPDATE_SCORES:");
        for (Map.Entry<String, Integer> entry : scores.entrySet()) {
            sb.append(entry.getKey()).append("=").append(entry.getValue()).append(",");
        }
        broadcastToRoom(sb.toString());
    }

    private void endGame() {
        isGameStarted = false;
        if (gameTimer != null) gameTimer.cancel();

        String winner = "No Winner";
        int maxScore = -1;
        
        for (Map.Entry<String, Integer> entry : scores.entrySet()) {
            if (entry.getValue() > maxScore) {
                maxScore = entry.getValue();
                winner = entry.getKey();
            }
        }

        String finalResult = (maxScore <= 0) ? "Game over! No points were scored." : "Winner is " + winner + " with " + maxScore + " points!";
        broadcastToRoom("GAME_OVER:" + finalResult);
        serverGUI.broadcastToLobby("PLAY_ROOM_AVAILABLE");
    }

    private void broadcastRoomUpdate() {
        String prefix = isWaitingQueue ? "LOBBY_UPDATE:" : "ROOM_UPDATE:";
        StringBuilder names = new StringBuilder(prefix);
        for (ClientHandler p : players) {
            names.append(p.getClientName()).append(",");
        }
        broadcastToRoom(names.toString());
    }

    public void broadcastToRoom(String msg) {
        for (ClientHandler p : players) {
            p.sendMessage(msg);
        }
    }

    public boolean isFullOrStarted() {
        return players.size() >= MAX_PLAYERS || isGameStarted;
    }
}

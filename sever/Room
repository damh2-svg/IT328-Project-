package server;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.Map;
import java.util.Timer;
import java.util.TimerTask;

public class Room {
    private ArrayList<ClientHandler> players;
    private final int MAX_PLAYERS = 4;
    private final int MAX_ROUNDS = 3; 
    private int currentRound = 0;
    private boolean isGameStarted = false;
    private boolean isWaitingQueue;
    private ServerGUI serverGUI;
    
    private Timer preGameTimer, roundTimer;
    private int preGameSeconds, roundSeconds;
    
    private Map<ClientHandler, String> submittedWords;
    private Map<ClientHandler, Integer> scores;
    private char targetLetter;

    public Room(boolean isWaitingQueue, ServerGUI serverGUI) {
        this.players = new ArrayList<>();
        this.isWaitingQueue = isWaitingQueue;
        this.serverGUI = serverGUI;
        this.submittedWords = new HashMap<>();
        this.scores = new HashMap<>();
    }

    public synchronized boolean addPlayer(ClientHandler player) {
        if (players.contains(player)) return false;

        if (isWaitingQueue) {
            players.add(player);
            broadcastRoomUpdate();
            player.sendMessage(serverGUI.isPlayRoomFull() ? "PLAY_ROOM_FULL" : "PLAY_ROOM_AVAILABLE");
            return true;
        }

        for (ClientHandler p : players) {
            p.sendMessage("NOTIFICATION:Player " + player.getClientName() + " has joined!");
        }

        players.add(player);
        player.sendMessage("ROOM_TYPE:PLAY_ROOM");
        broadcastRoomUpdate();

        if (isFullOrStarted()) serverGUI.broadcastToLobby("PLAY_ROOM_FULL");

               
        if (players.size() == 2 && !isGameStarted) {
            startPreGameTimer();
        } else if (players.size() == MAX_PLAYERS && !isGameStarted) {
           
            new Timer().schedule(new TimerTask() {
                @Override
                public void run() {
                    startGame(); 
                }
            }, 1000); 
        }


        return true;
    }

    public synchronized void removePlayer(ClientHandler player) {
        players.remove(player);
        scores.remove(player);
        broadcastRoomUpdate();
        broadcastScores();

        if (!isWaitingQueue) { 
            broadcastToRoom("NOTIFICATION:Player " + player.getClientName() + " has left!");
            
            if (isGameStarted) {
                if (players.size() == 1) {
                    broadcastToRoom("BIG_WINNER:🏆 " + players.get(0).getClientName() + " WINS BY DEFAULT 🏆");
                    new Timer().schedule(new TimerTask() {
                        @Override
                        public void run() { endFullGame("All other players left the game."); }
                    }, 4000);
                } else if (players.size() == 0) {
                    resetRoomState();
                }
            } else {
                if (players.size() < 2 && preGameTimer != null) {
                    preGameTimer.cancel();
                    broadcastToRoom("TIMER_STOP");
                }
            }
            
            if (!isFullOrStarted() && !isGameStarted) {
                serverGUI.broadcastToLobby("PLAY_ROOM_AVAILABLE");
            }
        }
    }

    private void startPreGameTimer() {
        if (preGameTimer != null) preGameTimer.cancel();
        preGameSeconds = 30; 
        preGameTimer = new Timer();
        preGameTimer.scheduleAtFixedRate(new TimerTask() {
            @Override
            public void run() {
                if (preGameSeconds > 0) {
                    broadcastToRoom("TIMER_UPDATE:" + preGameSeconds);
                    preGameSeconds--;
                } else {
                    currentRound = 0; 
                    scores.clear();   
                    startGame();
                }
            }
        }, 0, 1000);
    }

        private synchronized void startGame() {
        if (preGameTimer != null) preGameTimer.cancel();
        
        
        if (!isGameStarted) {
            isGameStarted = true;
            broadcastToRoom("NOTIFICATION:🔥 GAME STARTED! 🔥");
            broadcastToRoom("TIMER_STOP"); // إيقاف تايمر الانتظار
            
            // ننتظر 3 ثواني قبل توليد أول حرف وبدء الجولة
            new Timer().schedule(new TimerTask() {
                @Override
                public void run() {
                    startNextRoundSequence();
                }
            }, 3000);
        } else {
            startNextRoundSequence();
        }
    }

    
    private void startNextRoundSequence() {
        currentRound++;
        targetLetter = (char) ('A' + new java.util.Random().nextInt(26));
        submittedWords.clear();
        for (ClientHandler p : players) scores.putIfAbsent(p, 0);

        broadcastToRoom("NOTIFICATION:--- ROUND " + currentRound + " OF " + MAX_ROUNDS + " ---");
        broadcastToRoom("GAME_STARTED:" + targetLetter);
        broadcastScores();

        roundSeconds = 15; 
        if (roundTimer != null) roundTimer.cancel();
        roundTimer = new Timer();
        roundTimer.scheduleAtFixedRate(new TimerTask() {
            @Override
            public void run() {
                if (roundSeconds > 0) {
                    broadcastToRoom("ROUND_TIMER:" + roundSeconds);
                    roundSeconds--;
                } else {
                    evaluateRound();
                }
            }
        }, 0, 1000);
    }


    private synchronized void evaluateRound() {
        if (roundTimer != null) roundTimer.cancel();
        ClientHandler roundWinner = null;
        String longestWord = "";

        for (Map.Entry<ClientHandler, String> entry : submittedWords.entrySet()) {
            String word = entry.getValue();
            if (word != null && word.length() > longestWord.length() && Character.toUpperCase(word.charAt(0)) == targetLetter) {
                longestWord = word;
                roundWinner = entry.getKey();
            }
        }

        if (roundWinner != null) {
            scores.put(roundWinner, scores.get(roundWinner) + 1);
            broadcastScores();
            broadcastToRoom("NOTIFICATION:Round " + currentRound + " winner: " + roundWinner.getClientName());
        } else {
            broadcastToRoom("NOTIFICATION:Round " + currentRound + " ended with no winner.");
        }

        if (currentRound < MAX_ROUNDS && players.size() > 1) {
            new Timer().schedule(new TimerTask() {
                @Override
                public void run() { startGame(); }
            }, 3000); 
        } else {
            determineFinalWinner();
        }
    }

    private void determineFinalWinner() {
        ClientHandler finalWinner = null;
        int maxScore = -1;
        boolean tie = false;

        for (Map.Entry<ClientHandler, Integer> entry : scores.entrySet()) {
            if (entry.getValue() > maxScore) {
                maxScore = entry.getValue();
                finalWinner = entry.getKey();
                tie = false;
            } else if (entry.getValue() == maxScore && maxScore != 0) {
                tie = true;
            }
        }

        if (tie) {
            broadcastToRoom("BIG_WINNER:It's a TIE!");
            new Timer().schedule(new TimerTask() {
                @Override
                public void run() { endFullGame("Game Over! No clear winner."); }
            }, 4000);
        }
        else if (finalWinner != null && maxScore > 0) {
            finalWinner.sendMessage("YOU_WON:FINAL_VICTORY"); 
        } else {
            broadcastToRoom("BIG_WINNER:No one scored points!");
            new Timer().schedule(new TimerTask() {
                @Override
                public void run() { endFullGame("Game Over!"); }
            }, 4000);
        }
    }

    public synchronized void announceWinnerAndEnd(String winnerName) {
        broadcastToRoom("BIG_WINNER:🏆 CHAMPION: " + winnerName + " 🏆");
        new Timer().schedule(new TimerTask() {
            @Override
            public void run() {
                endFullGame("The game has officially ended!");
            }
        }, 4000);
    }

    public synchronized void endFullGame(String message) {
        broadcastToRoom("GAME_ENDED:" + message);
        resetRoomState();
    }

    private void resetRoomState() {
        isGameStarted = false;
        currentRound = 0;
        if (roundTimer != null) roundTimer.cancel();
        if (preGameTimer != null) preGameTimer.cancel();
        serverGUI.broadcastToLobby("PLAY_ROOM_AVAILABLE");
    }

    public void broadcastToRoom(String msg) {
        for (ClientHandler p : players) p.sendMessage(msg);
    }

    private void broadcastRoomUpdate() {
        String prefix = isWaitingQueue ? "LOBBY_UPDATE:" : "ROOM_UPDATE:";
        StringBuilder names = new StringBuilder(prefix);
        for (ClientHandler p : players) names.append(p.getClientName()).append(",");
        broadcastToRoom(names.toString());
    }

    private void broadcastScores() {
        StringBuilder sb = new StringBuilder("SCORES_UPDATE:");
        for (ClientHandler p : players) sb.append(p.getClientName()).append("=").append(scores.getOrDefault(p, 0)).append(",");
        broadcastToRoom(sb.toString());
    }

    public void submitWord(ClientHandler player, String word) {
        if (isGameStarted) submittedWords.put(player, word.trim());
    }

    public boolean isFullOrStarted() { return players.size() >= MAX_PLAYERS || isGameStarted; }
}
